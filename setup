#!/usr/bin/env bash
# report-factory setup (macOS/Linux) — 의존성 설치 + 스모크 테스트
set -e
root="$(cd "$(dirname "$0")" && pwd)"

echo "report-factory setup"
python3 --version || { echo "python3 이 필요합니다 (3.11+)"; exit 1; }
python3 -m pip install -q -r "$root/requirements.txt"
PYTHONUTF8=1 python3 "$root/report-factory/engine/tools/verify.py" --help >/dev/null
PYTHONUTF8=1 python3 "$root/report-factory/engine/tools/build_guide.py" --help >/dev/null
PYTHONUTF8=1 python3 "$root/report-factory/engine/tools/gen_preamble.py" --check
PYTHONUTF8=1 python3 "$root/report-factory/engine/tools/questionnaire_selftest.py" | tail -1
echo "설치 완료. 이 폴더를 Claude Code 작업 폴더로 여세요."
echo "  스킬: /설문지작성  /웹테스트  /제작가이드  /보고서작성  /회고  /업그레이드  /개선공유"
